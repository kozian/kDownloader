            "value": "Форматы:"
          }
        }
      }
    },
    "Free up some space or choose another folder.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Освободите место на диске или выберите другую папку."
          }
        }
      }
    },
    "GitHub sent an unexpected answer. Try again later.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub прислал неожиданный ответ. Попробуйте позже."
          }
        }
      }
    },
    "Give kDownloader Full Disk Access in System Settings → Privacy & Security, then try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайте kDownloader полный доступ к диску в Системных настройках → Конфиденциальность и безопасность и попробуйте снова."
          }
        }
      }
    },
    "Included in the video": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Входит в видео"
          }
