      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать все форматы"
          }
        }
      }
    },
    "Show in Finder": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать в Finder"
          }
        }
      }
    },
    "Sign-in required": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется вход"
          }
        }
      }
    },
    "Site is rate limiting requests": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Площадка ограничила запросы"
          }
        }
      }
    },
    "Site not supported": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Площадка не поддерживается"
          }
        }
      }
    },
    "Something went wrong. The log has the details.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то пошло не так. Подробности — в журнале."
          }
        }
      }
    },
    "The app is damaged — please reinstall it": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение повреждено — переустановите его"
          }
        }
      }
    },
    "The downloaded streams could not be processed.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обработать загруженные потоки."
          }
        }
      }
    },
    "The log is not available.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал недоступен."
          }
        }
      }
    },
    "The owner has not made this video available in your region.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Владелец не сделал это видео доступным в вашем регионе."
          }
        }
      }
    },
    "The previously selected folder is not available, so Downloads is used.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ранее выбранная папка недоступна, поэтому используется папка «Загрузки»."
          }
        }
      }
    },
    "The site has temporarily limited requests. Wait a while and try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Площадка временно ограничила запросы. Подождите немного и попробуйте снова."
          }
        }
      }
    },
    "The site requires signing in to watch this video.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы посмотреть это видео, площадка требует войти в аккаунт."
          }
        }
      }
    },
    "The video may have been deleted or made unavailable.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможно, видео удалено или скрыто."
          }
        }
      }
    },
    "This video is available only to channel members or subscribers.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это видео доступно только спонсорам или подписчикам канала."
          }
        }
      }
    },
    "This video needs you to be signed in. kDownloader can use the cookies of a browser where you are signed in to the site. Cookies are read only for this download and are never stored.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого видео нужно войти в аккаунт. kDownloader может использовать cookies браузера, в котором вы вошли на эту площадку. Cookies читаются только для этой загрузки и нигде не сохраняются."
          }
        }
      }
    },
    "Try again after the stream has ended.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте снова после окончания трансляции."
          }
        }
      }
    },
    "Unknown error": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неизвестная ошибка"
          }
        }
      }
    },
    "Use cookies from your browser?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать cookies браузера?"
          }
        }
      }
    },
    "Used only when a video needs signing in, after a first attempt without cookies.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используются, только если видео требует входа, — после первой попытки без cookies."
          }
        }
      }
    },
    "Version %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Версия %@"
          }
        }
      }
    },
