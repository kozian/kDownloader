      }
    },
    "Give kDownloader Full Disk Access in System Settings → Privacy & Security, then try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайте kDownloader полный доступ к диску в Системных настройках → Конфиденциальность и безопасность и попробуйте снова."
          }
        }
      }
    },
    "Hardware decoding only on M3 and later": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аппаратное декодирование только на M3 и новее"
